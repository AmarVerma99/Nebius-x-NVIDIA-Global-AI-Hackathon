# Nebius Token Factory Configuration (Nemotron models)
# Sign up at Nebius Token Factory and generate an API key
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_MODEL=nvidia/nemotron-3-ultra
NEBIUS_REASONING_MODEL=nvidia/nemotron-4-340b-instruct

# Tavily AI Search API (Qualifies for the $3,000 "Best Use of Tavily" Prize)
# Sign up at https://tavily.com to obtain an API key for live web & CVE intelligence
TAVILY_API_KEY=

# Server and Database
PORT=5000
DATABASE_URL=./data/opscopilot.db
JWT_SECRET=replace_with_a_secure_long_random_jwt_secret_key_32bytes

# Security & CORS
ALLOWED_ORIGIN=http://localhost:5173
NODE_ENV=development

# Sandbox execution mode: simulated (safe isolated mock sandbox) or nebius_sandbox
SANDBOX_MODE=simulated
